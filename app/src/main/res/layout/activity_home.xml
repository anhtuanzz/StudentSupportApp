<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/screen_bg">
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="19dp" android:layout_marginBottom="13dp" android:background="@drawable/hero_orange">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <LinearLayout android:layout_height="wrap_content" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1">
            <TextView style="@style/Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_label_001" android:textColor="#FFF1D7" />
            <TextView android:id="@+id/txtWelcome" style="@style/Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_label_002" android:textColor="#FFFFFF" android:layout_marginTop="5dp" />
            <TextView style="@style/BodyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_label_003" android:textColor="#FFF8F0" android:layout_marginTop="8dp" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_label_004" android:textSize="50sp" android:gravity="center" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:id="@+id/cardChatbot" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:layout_marginBottom="14dp" android:background="@drawable/hero_peach" android:clickable="true" android:focusable="true" android:contentDescription="@string/home_chatbot_title" android:minHeight="83dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_chatbot_icon" android:textSize="35sp" android:layout_marginEnd="12dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
          <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_chatbot_title" />
          <TextView style="@style/Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_chatbot_description" android:layout_marginTop="5dp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_chatbot_arrow" android:textColor="@color/accent_deep" android:textSize="26sp" android:layout_marginStart="8dp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="15dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="101dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/card_bg">
          <TextView android:text="@string/home_label_005" android:textSize="21sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
          <TextView android:id="@+id/txtActiveCount" android:text="@string/home_label_006" android:textColor="@color/ink" android:textStyle="bold" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
          <TextView android:text="@string/home_label_007" android:textColor="@color/muted" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="101dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/card_bg">
          <TextView android:text="@string/home_label_008" android:textSize="21sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
          <TextView android:id="@+id/txtOrderCount" android:text="@string/home_label_009" android:textColor="@color/ink" android:textStyle="bold" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
          <TextView android:text="@string/home_label_010" android:textColor="@color/muted" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="101dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/card_bg">
          <TextView android:text="@string/home_label_011" android:textSize="21sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
          <TextView android:id="@+id/txtTicketCount" android:text="@string/home_label_012" android:textColor="@color/ink" android:textStyle="bold" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
          <TextView android:text="@string/home_label_013" android:textColor="@color/muted" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
      </LinearLayout>
      <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_label_014" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/btnPackages" style="@style/QuietButton" android:text="@string/home_label_015" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="8dp" />
        <Button android:id="@+id/btnOrders" style="@style/QuietButton" android:text="@string/home_label_016" android:layout_width="0dp" android:layout_weight="1" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/btnSupport" style="@style/QuietButton" android:text="@string/home_label_017" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="8dp" />
        <Button android:id="@+id/btnProfile" style="@style/QuietButton" android:text="@string/home_label_018" android:layout_width="0dp" android:layout_weight="1" />
      </LinearLayout>
      <View android:layout_width="match_parent" android:layout_height="12dp" />
      <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_label_019" android:layout_marginBottom="10dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp" android:layout_marginBottom="13dp" android:background="@drawable/card_bg" android:id="@+id/cardFeatured" android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_label_020" android:textSize="48sp" android:gravity="center" android:layout_marginEnd="13dp" />
          <LinearLayout android:layout_height="wrap_content" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1">
            <TextView style="@style/Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_label_021" />
            <TextView android:id="@+id/txtFeaturedName" style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_label_022" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/txtFeaturedPrice" style="@style/Money" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_label_023" android:layout_marginTop="5dp" />
          </LinearLayout>
        </LinearLayout>
        <TextView android:text="@string/home_label_024" android:textColor="@color/accent_deep" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp" android:layout_marginBottom="13dp" android:background="@drawable/card_bg">
        <TextView style="@style/SectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_label_025" />
        <TextView style="@style/Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_label_026" android:layout_marginTop="5dp" />
        <Button android:id="@+id/btnSubscriptions" style="@style/SecondaryButton" android:text="@string/home_label_027" android:layout_marginTop="13dp" />
      </LinearLayout>
      <Button android:id="@+id/btnStats" style="@style/QuietButton" android:text="@string/home_label_028" android:visibility="gone" />
      <TextView style="@style/Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_label_029" android:layout_marginTop="6dp" />
      <TextView android:id="@+id/txtRole" style="@style/Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_label_030" android:layout_marginTop="2dp" />
      <Button android:id="@+id/btnLogout" style="@style/SecondaryButton" android:text="@string/home_label_031" />
    </LinearLayout>
  </ScrollView>
  <include layout="@layout/include_bottom_nav" />
</LinearLayout>